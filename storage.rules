rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && (
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
          || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'member'
        );
    }

    // Process PDFs are staff-only. Download tokens are not stored; the portal opens files through the SDK.
    match /operational-systems/{systemId}/{fileName} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isStaff();
    }

    // Storefront catalogue art. These matches grant public read on their own,
    // so a failure in the catch-all check cannot hide product images.
    match /brands/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /product-images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{allPaths=**} {
      allow read: if allPaths[0] != 'operational-systems';
      allow write: if request.auth != null && allPaths[0] != 'operational-systems';
    }
  }
}
