rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isMemberOrAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'member');
    }

    // User profiles collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isMemberOrAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true; // Public read access for storefront catalog
      allow write: if isMemberOrAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isMemberOrAdmin());
      allow create: if true; // Customers & guests can place orders
      allow update, delete: if isMemberOrAdmin();
    }

    // Subscriptions collection
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isMemberOrAdmin());
      allow create: if isAuthenticated() && (request.resource.data.customerId == request.auth.uid || isMemberOrAdmin());
      allow update: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isMemberOrAdmin());
      allow delete: if isMemberOrAdmin();
    }

    // Stock Notifications collection
    match /stockNotifications/{id} {
      allow create: if true; // Public email submission for out-of-stock items
      allow read: if isAuthenticated() || isMemberOrAdmin();
      allow update, delete: if isMemberOrAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email));
    }

    // Coupons collection
    match /coupons/{code} {
      allow read: if true; // Public read to validate coupons at cart checkout
      allow write: if isMemberOrAdmin();
    }

    // Email Subscribers collection (Cigarettes Coming Soon)
    match /emailSubscribers/{id} {
      allow create: if true;
      allow read, write: if isMemberOrAdmin();
    }

    // Live product-page presence (anonymous storefront visitors)
    match /productPresence/{productId}/sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Live site-wide presence (anonymous storefront visitors)
    match /sitePresence/{sessionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Social proof toast feed (written only by Cloud Functions / Admin SDK)
    match /social_proof/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Daily generate idempotency markers — fully private
    match /social_proof_runs/{runId} {
      allow read, write: if false;
    }
  }
}
