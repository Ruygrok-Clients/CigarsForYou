rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isMemberOrAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'member');
    }

    function loyaltyFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'rewardsPoints',
        'loyaltyTier',
        'loyaltyWindowPoints',
        'loyaltyTierUpdatedAt'
      ]);
    }

    function ageVerificationFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ageVerified',
        'ageVerificationStatus',
        'diditSessionId',
        'ageVerifiedAt'
      ]);
    }

    // User profiles collection
    // rewardsPoints and loyalty tier fields are written only by Cloud Functions (Admin SDK bypasses these rules).
    match /users/{userId} {
      allow read: if isOwner(userId) || isMemberOrAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['rewardsPoints']) || request.resource.data.rewardsPoints == 0)
        && !request.resource.data.keys().hasAny(['loyaltyTier', 'loyaltyWindowPoints', 'loyaltyTierUpdatedAt'])
        && !request.resource.data.keys().hasAny(['ageVerified', 'ageVerificationStatus', 'diditSessionId', 'ageVerifiedAt']);
      allow update: if (isOwner(userId) || isAdmin()) && loyaltyFieldsUntouched() && ageVerificationFieldsUntouched();
      allow delete: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true; // Public read access for storefront catalog
      allow write: if isMemberOrAdmin();
    }

    function orderRewardsFieldsUntouched() {
      return request.resource.data.get('pointsEarned', null) == resource.data.get('pointsEarned', null)
        && request.resource.data.get('pointsClawedBack', false) == resource.data.get('pointsClawedBack', false)
        && request.resource.data.get('pointsSpent', 0) == resource.data.get('pointsSpent', 0)
        && request.resource.data.get('pointsRefunded', false) == resource.data.get('pointsRefunded', false)
        && request.resource.data.source == resource.data.source;
    }

    // Orders collection
    // Reward orders and points fields are written only by Cloud Functions.
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isMemberOrAdmin());
      allow create: if request.resource.data.source != 'Reward'
        && request.resource.data.get('pointsEarned', 0) == 0
        && request.resource.data.get('pointsClawedBack', false) == false
        && request.resource.data.get('pointsSpent', 0) == 0
        && request.resource.data.get('pointsRefunded', false) == false;
      allow update: if isMemberOrAdmin() && orderRewardsFieldsUntouched();
      allow delete: if isMemberOrAdmin();
    }

    // Rewards shop catalog (separate from store products)
    match /rewardProducts/{productId} {
      allow read: if true;
      allow write: if isMemberOrAdmin();
    }

    // News & blog posts (public when published; staff manage all)
    match /newsPosts/{postId} {
      allow read: if true;
      allow write: if isMemberOrAdmin();
    }

    // Tier thresholds. Staff write; signed-in customers read for progress copy.
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isMemberOrAdmin();
    }

    // Points earn / redeem / clawback audit log
    match /rewardsLedger/{entryId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isMemberOrAdmin());
      allow write: if false;
    }

    // Subscriptions collection
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isMemberOrAdmin());
      allow create: if isAuthenticated() && (request.resource.data.customerId == request.auth.uid || isMemberOrAdmin());
      allow update: if isAuthenticated() && (resource.data.customerId == request.auth.uid || isMemberOrAdmin());
      allow delete: if isMemberOrAdmin();
    }

    // Stock Notifications collection
    match /stockNotifications/{id} {
      allow create: if true; // Public email submission for out-of-stock items
      allow read: if isAuthenticated() || isMemberOrAdmin();
      allow update, delete: if isMemberOrAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email));
    }

    // Coupons collection
    match /coupons/{code} {
      allow read: if true; // Public read to validate coupons at cart checkout
      allow write: if isMemberOrAdmin();
    }

    // Email Subscribers collection (Cigarettes Coming Soon)
    match /emailSubscribers/{id} {
      allow create: if true;
      allow read, write: if isMemberOrAdmin();
    }

    // Live product-page presence (anonymous storefront visitors)
    match /productPresence/{productId}/sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Live site-wide presence (anonymous storefront visitors)
    match /sitePresence/{sessionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Social proof toast feed (written only by Cloud Functions / Admin SDK)
    match /social_proof/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Current site-viewer count for the toast (written only by Cloud Functions)
    match /social_proof_live/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Daily generate idempotency markers — fully private
    match /social_proof_runs/{runId} {
      allow read, write: if false;
    }

    // Didit age verification. Written only by Cloud Functions (Admin SDK).
    match /ageVerifications/{sessionId} {
      allow read, write: if false;
    }

    match /pendingSignups/{signupId} {
      allow read, write: if false;
    }

    match /diditWebhookEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
