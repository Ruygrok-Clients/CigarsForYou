# Firebase Cloud Functions Secrets Configuration
# Fill in production values when deploying to Firebase Cloud Functions:
# firebase functions:secrets:set RESEND_API_KEY

PAYPAL_CLIENT_ID=paypal_client_id_placeholder
PAYPAL_CLIENT_SECRET=paypal_client_secret_placeholder
SENDGRID_API_KEY=SG.placeholder_api_key

# Resend Email Integration Config
RESEND_API_KEY=re_placeholder_api_key
RESEND_FROM_EMAIL=CigarsForYou <noreply@cigarsforyou.com.au>
ADMIN_NOTIFICATION_EMAILS=admin@cigarsforyou.com.au

# Geocoding for Immediate Dispatch quotes. Set with:
# firebase functions:secrets:set GOOGLE_MAPS_API_KEY
# Enable the Geocoding API on the same Google Cloud project. Do not put this key in Vite env.
GOOGLE_MAPS_API_KEY=

# Didit age verification. Set with:
# firebase functions:secrets:set DIDIT_API_KEY
# firebase functions:secrets:set DIDIT_WEBHOOK_SECRET
# Workflow id lives in functions/src/didit.ts (not an env var).
# Register the webhook in the Didit console:
# https://<your-domain>/api/webhooks/didit
# webhook_version v3, events: status.updated, data.updated
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
